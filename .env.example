# Copy this file to .env and replace every replace_with_* placeholder locally.
# Never commit .env or real credentials.

NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_BASE_URL=http://127.0.0.1:3000
TRUST_PROXY=false

DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=food_ordering_dev
DATABASE_USER=food_ordering_app
DATABASE_PASSWORD=replace_with_local_database_password
DATABASE_SSL=false

MIGRATION_DATABASE_USER=food_ordering_migrator
MIGRATION_DATABASE_PASSWORD=replace_with_local_migration_password

SESSION_SECRET=replace_with_random_value_at_least_32_characters
SESSION_COOKIE_NAME=food_ordering_sid
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_SECURE_COOKIE=false

LOG_LEVEL=info
BACKUP_DIRECTORY=backups
