<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow, noarchive">
    <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Vulnerable Demo' %> · Northstar Kitchen</title>
    <link rel="stylesheet" href="/assets/styles.css">
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header class="site-header">
      <div class="shell header-inner">
        <div class="brand-group">
          <a class="brand" href="/" aria-label="Northstar Kitchen home">
            <span class="brand-mark" aria-hidden="true">N</span>
            <span>
              <strong>Northstar</strong>
              <small>Kitchen</small>
            </span>
          </a>
          <span class="env-badge env-badge-vulnerable">INTENTIONALLY VULNERABLE · LOCAL DEMO · PORT 3100</span>
        </div>
        <nav aria-label="Primary navigation">
          <a class="<%= typeof activePath !== 'undefined' && activePath === '/' ? 'nav-link is-active' : 'nav-link' %>" href="/">Menu</a>
          <a class="<%= typeof activePath !== 'undefined' && activePath === '/search' ? 'nav-link is-active' : 'nav-link' %>" href="/search">Search</a>
          <% if (typeof currentUser !== 'undefined' && currentUser) { %>
            <a class="<%= typeof activePath !== 'undefined' && activePath === '/admin/orders' ? 'nav-link is-active' : 'nav-link' %>" href="/admin/orders">Manage orders</a>
            <a class="<%= typeof activePath !== 'undefined' && activePath === '/admin/audit-logs' ? 'nav-link is-active' : 'nav-link' %>" href="/admin/audit-logs">Audit logs</a>
            <span class="nav-identity">
              Signed in as <strong><%= currentUser.name %></strong>
            </span>
            <form class="nav-logout" method="post" action="/logout">
              <button type="submit">Sign out</button>
            </form>
          <% } else { %>
            <a class="<%= typeof activePath !== 'undefined' && activePath === '/admin/orders' ? 'nav-link is-active' : 'nav-link' %>" href="/admin/orders">Manage orders</a>
            <a class="<%= typeof activePath !== 'undefined' && activePath === '/admin/audit-logs' ? 'nav-link is-active' : 'nav-link' %>" href="/admin/audit-logs">Audit logs</a>
            <a class="<%= typeof activePath !== 'undefined' && activePath === '/login' ? 'nav-action is-active' : 'nav-action' %>" href="/login">Sign in</a>
          <% } %>
        </nav>
      </div>
    </header>
