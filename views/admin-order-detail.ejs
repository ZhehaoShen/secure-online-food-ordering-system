<%- include("partials/header", { pageTitle, activePath }) %>

<main id="main-content" class="admin-main">
  <div class="shell">
    <% if (order) { %>
      <section class="admin-order-detail-heading" aria-labelledby="admin-order-heading">
        <div>
          <p class="section-kicker">Administrator order review</p>
          <h1 id="admin-order-heading">Order<br><em>#<%= order.id %>.</em></h1>
        </div>
        <div class="order-confirmation-meta">
          <span class="status-pill status-<%= order.status %>">
            <%= order.statusLabel %>
          </span>
          <p>Placed <%= order.created %></p>
        </div>
      </section>

      <% if (notice) { %>
        <p class="form-notice" role="status"><%= notice %></p>
      <% } %>

      <% if (errors.length > 0) { %>
        <div class="form-errors" role="alert">
          <p>The order status could not be updated.</p>
          <ul>
            <% errors.forEach((error) => { %>
              <li><%= error %></li>
            <% }); %>
          </ul>
        </div>
      <% } %>

      <div class="admin-order-detail-layout">
        <div>
          <section class="admin-customer-card" aria-labelledby="customer-heading">
            <p class="section-kicker">Customer</p>
            <h2 id="customer-heading"><%= order.customerName %></h2>
            <p><%= order.customerEmail %></p>
          </section>

          <section class="order-detail-items" aria-label="Order items">
            <% order.items.forEach((item) => { %>
              <article class="order-detail-item">
                <div>
                  <p class="section-kicker">Quantity <%= item.quantity %></p>
                  <h2><%= item.foodNameSnapshot %></h2>
                  <p><%= item.unitPrice %> each</p>
                </div>
                <strong><%= item.lineTotal %></strong>
              </article>
            <% }); %>
          </section>
        </div>

        <aside class="admin-order-sidebar">
          <div class="admin-order-total">
            <p class="section-kicker">Server total</p>
            <h2>Order total</h2>
            <strong><%= order.total %></strong>
          </div>

          <div class="admin-status-panel">
            <p class="section-kicker">Status workflow</p>
            <h2>Current: <%= order.statusLabel %></h2>
            <% if (order.transitions.length > 0) { %>
              <p>Choose one allowed next state.</p>
              <form
                method="post"
                action="/admin/orders/<%= order.id %>/status"
              >
                <% order.transitions.forEach((transition) => { %>
                  <button
                    name="status"
                    type="submit"
                    value="<%= transition.value %>"
                  >Mark <%= transition.label %></button>
                <% }); %>
              </form>
            <% } else { %>
              <p>No further status changes are allowed.</p>
            <% } %>
          </div>

          <a class="text-link" href="/admin/orders">
            Return to all orders
          </a>
        </aside>
      </div>
    <% } else { %>
      <div class="empty-state admin-order-missing">
        <span class="empty-mark" aria-hidden="true">404</span>
        <div>
          <p class="section-kicker">Order unavailable</p>
          <h1>The order could not be found.</h1>
          <p>Return to the administrator order list to select another order.</p>
          <a class="text-link" href="/admin/orders">
            Return to all orders
          </a>
        </div>
      </div>
    <% } %>
  </div>
</main>

<%- include("partials/footer") %>
