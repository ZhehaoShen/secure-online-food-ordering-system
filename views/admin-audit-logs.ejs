<%- include("partials/header", { pageTitle, activePath }) %>

<main id="main-content" class="admin-main">
  <div class="shell">
    <section class="admin-heading" aria-labelledby="admin-audit-heading">
      <div>
        <p class="section-kicker">Administrator workspace</p>
        <h1 id="admin-audit-heading">Audit<br><em>logs.</em></h1>
      </div>
      <p class="admin-order-count">
        <%= pagination.total %>
        <%= pagination.total === 1 ? "record" : "records" %>
      </p>
    </section>

    <% if (logs.length > 0) { %>
      <section class="admin-audit-list" aria-label="System audit logs">
        <table class="audit-table" style="width: 100%; border-collapse: collapse; margin-top: 1rem;">
          <thead>
            <tr style="border-bottom: 2px solid #ddd; text-align: left;">
              <th style="padding: 8px;">Time</th>
              <th style="padding: 8px;">Action</th>
              <th style="padding: 8px;">Actor</th>
              <th style="padding: 8px;">Target</th>
              <th style="padding: 8px;">Result</th>
              <th style="padding: 8px;">Details</th>
            </tr>
          </thead>
          <tbody>
            <% logs.forEach((log) => { %>
              <tr style="border-bottom: 1px solid #eee;">
                <td style="padding: 8px; font-size: 0.9em; white-space: nowrap;">
                  <%= new Date(log.createdAt).toLocaleString() %>
                </td>
                <td style="padding: 8px;">
                  <code><%= log.action %></code>
                </td>
                <td style="padding: 8px;">
                  <% if (log.actorName) { %>
                    <strong><%= log.actorName %></strong> (ID: <%= log.actorUserId %>)
                  <% } else if (log.actorUserId) { %>
                    User #<%= log.actorUserId %>
                  <% } else { %>
                    <em>Anonymous</em>
                  <% } %>
                </td>
                <td style="padding: 8px;">
                  <%= log.entityType %><% if (log.entityId) { %> #<%= log.entityId %><% } %>
                </td>
                <td style="padding: 8px;">
                  <span class="status-pill status-<%= log.result === 'success' ? 'completed' : 'cancelled' %>">
                    <%= log.result %>
                  </span>
                </td>
                <td style="padding: 8px; font-size: 0.85em;">
                  <code><%= JSON.stringify(log.details) %></code>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>

        <% if (pagination.totalPages > 1) { %>
          <div class="pagination" style="margin-top: 1.5rem; display: flex; gap: 1rem; align-items: center;">
            <% if (pagination.page > 1) { %>
              <a class="text-link" href="/admin/audit-logs?page=<%= pagination.page - 1 %>">Previous</a>
            <% } %>
            <span>Page <%= pagination.page %> of <%= pagination.totalPages %></span>
            <% if (pagination.page < pagination.totalPages) { %>
              <a class="text-link" href="/admin/audit-logs?page=<%= pagination.page + 1 %>">Next</a>
            <% } %>
          </div>
        <% } %>
      </section>
    <% } else { %>
      <div class="empty-state admin-order-empty">
        <span class="empty-mark" aria-hidden="true">0</span>
        <div>
          <p class="section-kicker">No audit logs</p>
          <h2>No audit logs have been recorded yet.</h2>
          <p>Perform system actions such as sign-in, order creation, or food updates to populate logs.</p>
        </div>
      </div>
    <% } %>
  </div>
</main>

<%- include("partials/footer") %>
