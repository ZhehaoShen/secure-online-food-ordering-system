<%- include("partials/header", { pageTitle, activePath }) %>

<main id="main-content" class="cart-main">
  <div class="shell">
    <section class="cart-heading" aria-labelledby="cart-heading">
      <div>
        <p class="section-kicker">Order draft</p>
        <h1 id="cart-heading">Your<br><em>cart.</em></h1>
      </div>
      <p class="cart-count">
        <%= cart.itemCount %>
        <%= cart.itemCount === 1 ? "item" : "items" %>
      </p>
    </section>

    <% if (errors.length > 0) { %>
      <div class="form-errors" role="alert" aria-labelledby="cart-error-title">
        <p id="cart-error-title">The cart could not be updated.</p>
        <ul>
          <% errors.forEach((error) => { %>
            <li><%= error %></li>
          <% }); %>
        </ul>
      </div>
    <% } %>

    <div class="cart-layout">
      <% if (cart.items.length > 0) { %>
        <section class="cart-items" aria-label="Cart items">
          <% cart.items.forEach((item) => { %>
            <article class="cart-item">
              <div>
                <span class="category-label"><%= item.category %></span>
                <h2><%= item.name %></h2>
                <p><%= item.price %> each · quantity <%= item.quantity %></p>

                <div class="cart-item-actions">
                  <form
                    method="post"
                    action="/cart/items/<%= item.id %>/update"
                  >
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <label>
                      Quantity
                      <input
                        name="quantity"
                        type="number"
                        min="1"
                        max="99"
                        value="<%= item.quantity %>"
                        required
                      >
                    </label>
                    <button type="submit">Update</button>
                  </form>
                  <form
                    method="post"
                    action="/cart/items/<%= item.id %>/remove"
                  >
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button class="remove-button" type="submit">Remove</button>
                  </form>
                </div>
              </div>
              <div class="cart-item-price">
                <strong><%= item.lineTotal %></strong>
                <span>Line total</span>
              </div>
            </article>
          <% }); %>
        </section>

        <aside class="cart-summary" aria-labelledby="cart-summary-heading">
          <h2 id="cart-summary-heading">Order draft</h2>
          <div class="cart-summary-row">
            <span>Items</span>
            <strong><%= cart.itemCount %></strong>
          </div>
          <div class="cart-summary-total">
            <span>Total</span>
            <strong><%= cart.total %></strong>
          </div>
          <form class="checkout-form" method="post" action="/orders">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="checkout-button" type="submit">Place order</button>
          </form>
          <p class="cart-summary-note">
            Prices and totals are loaded and calculated by the server.
            Your cart clears only after the complete order is saved.
          </p>
        </aside>
      <% } else { %>
        <div class="empty-state cart-empty">
          <span class="empty-mark" aria-hidden="true">0</span>
          <div>
            <p class="section-kicker">Order draft empty</p>
            <h3>Your cart has no available foods.</h3>
            <p>Browse the menu or search for a dish to begin an order.</p>
            <p>Current total: <strong><%= cart.total %></strong></p>
            <a class="text-link" href="/">Browse the menu</a>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</main>

<%- include("partials/footer") %>
