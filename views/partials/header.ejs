<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta
      name="description"
      content="A fictional secure online food-ordering project."
    >
    <title><%= pageTitle %> · Northstar Kitchen</title>
    <link rel="stylesheet" href="/assets/styles.css">
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="/" aria-label="Northstar Kitchen home">
          <span class="brand-mark" aria-hidden="true">N</span>
          <span>
            <strong>Northstar</strong>
            <small>Kitchen</small>
          </span>
        </a>
        <nav aria-label="Primary navigation">
          <a
            class="<%= activePath === '/' ? 'nav-link is-active' : 'nav-link' %>"
            href="/"
          >Menu</a>
          <a class="nav-link" href="/search">Search</a>
          <a class="nav-link" href="/orders">Orders</a>
          <a class="nav-action" href="/login">Sign in</a>
        </nav>
      </div>
    </header>
