<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta
      name="description"
      content="A fictional secure online food-ordering project."
    >
    <title><%= pageTitle %> · Northstar Kitchen</title>
    <link rel="stylesheet" href="/assets/styles.css">
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="/" aria-label="Northstar Kitchen home">
          <span class="brand-mark" aria-hidden="true">N</span>
          <span>
            <strong>Northstar</strong>
            <small>Kitchen</small>
          </span>
        </a>
        <nav aria-label="Primary navigation">
          <a
            class="<%= activePath === '/' ? 'nav-link is-active' : 'nav-link' %>"
            href="/"
          >Menu</a>
          <a
            class="<%= activePath === '/search'
              ? 'nav-link is-active'
              : 'nav-link' %>"
            href="/search"
          >Search</a>
          <% if (currentUser) { %>
            <a
              class="<%= activePath === '/cart'
                ? 'nav-link is-active'
                : 'nav-link' %>"
              href="/cart"
            >Cart</a>
            <a
              class="<%= activePath === '/orders'
                ? 'nav-link is-active'
                : 'nav-link' %>"
              href="/orders"
            >Orders</a>
            <% if (currentUser.role === "admin") { %>
              <a
                class="<%= activePath === '/admin/food-items'
                  ? 'nav-link is-active'
                  : 'nav-link' %>"
                href="/admin/food-items"
              >Manage food</a>
              <a
                class="<%= activePath === '/admin/orders'
                  ? 'nav-link is-active'
                  : 'nav-link' %>"
                href="/admin/orders"
              >Manage orders</a>
            <% } %>
            <span class="nav-identity">
              Signed in as <strong><%= currentUser.name %></strong>
            </span>
            <form class="nav-logout" method="post" action="/logout">
              <button type="submit">Sign out</button>
            </form>
          <% } else { %>
            <a
              class="<%= activePath === '/register'
                ? 'nav-link is-active'
                : 'nav-link' %>"
              href="/register"
            >Register</a>
            <a
              class="<%= activePath === '/login'
                ? 'nav-action is-active'
                : 'nav-action' %>"
              href="/login"
            >Sign in</a>
          <% } %>
        </nav>
      </div>
    </header>
