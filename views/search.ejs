<%- include("partials/header", { pageTitle, activePath }) %>

<main id="main-content" class="search-main">
  <div class="shell">
    <section class="search-heading" aria-labelledby="search-heading">
      <div>
        <p class="section-kicker">Find a dish</p>
        <h1 id="search-heading">Search the<br><em>menu.</em></h1>
      </div>
      <p>
        Search available fictional foods by name, narrow by category, or
        combine both filters.
      </p>
    </section>

    <section class="search-panel" aria-label="Food search filters">
      <% if (errors.length > 0) { %>
        <div class="form-errors" role="alert" aria-labelledby="search-error-title">
          <p id="search-error-title">The search could not be completed.</p>
          <ul>
            <% errors.forEach((error) => { %>
              <li><%= error %></li>
            <% }); %>
          </ul>
        </div>
      <% } %>

      <form class="search-form" method="get" action="/search">
        <div class="form-field">
          <label for="q">Food name</label>
          <input
            id="q"
            name="q"
            type="search"
            value="<%= query || '' %>"
            maxlength="120"
            placeholder="Try wrap, soup, or berry"
          >
        </div>

        <div class="form-field">
          <label for="category">Category</label>
          <select id="category" name="category">
            <option value="">All categories</option>
            <% categories.forEach((category) => { %>
              <option
                value="<%= category %>"
                <%= selectedCategory &&
                  selectedCategory.toLowerCase() === category.toLowerCase()
                  ? "selected"
                  : "" %>
              ><%= category %></option>
            <% }); %>
          </select>
        </div>

        <button class="search-button" type="submit">Search menu</button>
      </form>
    </section>

    <section aria-labelledby="search-results-heading">
      <div class="search-results-heading">
        <div>
          <p class="section-kicker">Search results</p>
          <h2 id="search-results-heading">
            <% if (query || selectedCategory) { %>
              Matching available dishes
            <% } else { %>
              All available dishes
            <% } %>
          </h2>
        </div>
        <p class="search-count">
          <%= foods.length %> <%= foods.length === 1 ? "result" : "results" %>
        </p>
      </div>

      <% if (foods.length > 0) { %>
        <div class="menu-grid">
          <% foods.forEach((food, index) => { %>
            <article class="menu-card">
              <div class="card-index" aria-hidden="true">
                <span><%= String(index + 1).padStart(2, "0") %></span>
                <span class="index-line"></span>
              </div>
              <div class="card-content">
                <div class="card-meta">
                  <span class="category-label"><%= food.category %></span>
                  <span class="availability">
                    <span aria-hidden="true"></span>
                    Available
                  </span>
                </div>
                <h3><%= food.name %></h3>
                <p><%= food.description %></p>
                <div class="card-footer">
                  <strong><%= food.price %></strong>
                  <span>CAD</span>
                </div>
                <% if (currentUser) { %>
                  <form class="card-order-form" method="post" action="/cart/items">
                    <input type="hidden" name="foodItemId" value="<%= food.id %>">
                    <label>
                      <span>Quantity</span>
                      <input
                        name="quantity"
                        type="number"
                        min="1"
                        max="99"
                        value="1"
                        required
                      >
                    </label>
                    <button type="submit">Add to cart</button>
                  </form>
                <% } else { %>
                  <a class="card-sign-in" href="/login">Sign in to order</a>
                <% } %>
              </div>
            </article>
          <% }); %>
        </div>
      <% } else { %>
        <div class="empty-state">
          <span class="empty-mark" aria-hidden="true">0</span>
          <div>
            <p class="section-kicker">No matches</p>
            <h3>No available dishes match these filters.</h3>
            <p>Try another name or category, or return to all available foods.</p>
            <a class="text-link" href="/search">Clear search filters</a>
          </div>
        </div>
      <% } %>
    </section>
  </div>
</main>

<%- include("partials/footer") %>
