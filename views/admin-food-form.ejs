<%- include("partials/header", { pageTitle, activePath }) %>

<main id="main-content" class="admin-main">
  <div class="shell">
    <% if (missing) { %>
      <div class="empty-state admin-food-missing">
        <span class="empty-mark" aria-hidden="true">404</span>
        <div>
          <p class="section-kicker">Food item unavailable</p>
          <h1>The food item could not be found.</h1>
          <p>Return to the management list to select another item.</p>
          <a class="text-link" href="/admin/food-items">
            Return to managed food
          </a>
        </div>
      </div>
    <% } else { %>
      <section class="admin-form-layout">
        <div class="admin-form-intro">
          <p class="section-kicker">Administrator workspace</p>
          <h1>
            <%= mode === "create" ? "Add a" : "Edit the" %>
            <br><em>food item.</em>
          </h1>
          <p>
            Prices are entered in Canadian dollars. Disabled foods stay in
            historical orders but disappear from the public menu.
          </p>
        </div>

        <div class="admin-form-panel">
          <% if (errors.length > 0) { %>
            <div class="form-errors" role="alert">
              <p>The food item could not be saved.</p>
              <ul>
                <% errors.forEach((error) => { %>
                  <li><%= error %></li>
                <% }); %>
              </ul>
            </div>
          <% } %>

          <form
            class="admin-food-form"
            method="post"
            action="<%= mode === 'create'
              ? '/admin/food-items'
              : `/admin/food-items/${foodItemId}` %>"
          >
            <div class="form-field">
              <label for="food-name">Name</label>
              <input
                id="food-name"
                name="name"
                type="text"
                maxlength="120"
                value="<%= form.name %>"
                required
              >
            </div>

            <div class="form-field">
              <label for="food-category">Category</label>
              <input
                id="food-category"
                name="category"
                type="text"
                maxlength="80"
                value="<%= form.category %>"
                required
              >
            </div>

            <div class="form-field">
              <label for="food-description">Description</label>
              <textarea
                id="food-description"
                name="description"
                maxlength="2000"
                rows="5"
              ><%= form.description %></textarea>
            </div>

            <div class="form-field">
              <label for="food-price">Price in CAD</label>
              <input
                id="food-price"
                name="price"
                type="number"
                min="0"
                max="21474836.47"
                step="0.01"
                inputmode="decimal"
                value="<%= form.price %>"
                required
              >
            </div>

            <label class="checkbox-field">
              <input
                name="isAvailable"
                type="checkbox"
                <%= form.isAvailable ? "checked" : "" %>
              >
              <span>Available on the public menu</span>
            </label>

            <div class="admin-form-actions">
              <button class="primary-button" type="submit">
                <%= mode === "create"
                  ? "Create food item"
                  : "Save changes" %>
              </button>
              <a class="text-link" href="/admin/food-items">Cancel</a>
            </div>
          </form>
        </div>
      </section>
    <% } %>
  </div>
</main>

<%- include("partials/footer") %>
