{
  "name": "secure-online-food-ordering-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "install:clean": "npm ci --ignore-scripts",
    "start": "node --env-file-if-exists=.env src/server.js",
    "healthcheck": "node --env-file-if-exists=.env scripts/healthcheck.js",
    "check:syntax": "node scripts/check-javascript.js",
    "test": "vitest run",
    "test:day3": "vitest run tests/unit tests/integration",
    "test:day4": "vitest run --config vitest.day4.config.js",
    "demo:vulnerable:setup": "node --env-file-if-exists=demo/vulnerable/.env demo/vulnerable/setup.js",
    "demo:vulnerable:reset": "node --env-file-if-exists=demo/vulnerable/.env demo/vulnerable/reset.js",
    "demo:vulnerable:start": "node --env-file-if-exists=demo/vulnerable/.env demo/vulnerable/server.js",
    "test:demo": "vitest run demo/vulnerable",
    "test:demo:sql": "vitest run demo/vulnerable/sql-injection-scenario.test.js",
    "test:demo:baseline": "vitest run demo/vulnerable/baseline-scenarios.test.js",
    "db:roles": "node --env-file-if-exists=.env scripts/database-task.js roles",
    "db:migrate": "node --env-file-if-exists=.env scripts/database-task.js migrate",
    "db:seed": "node --env-file-if-exists=.env scripts/database-task.js seed",
    "db:setup": "node --env-file-if-exists=.env scripts/database-task.js migrate && node --env-file-if-exists=.env scripts/database-task.js seed",
    "db:backup": "node --env-file-if-exists=.env scripts/database-task.js backup",
    "db:restore": "node --env-file-if-exists=.env scripts/database-task.js restore",
    "shutdown": "node scripts/shutdown.js"
  },
  "engines": {
    "node": ">=24.18.0 <27"
  },
  "dependencies": {
    "connect-pg-simple": "10.0.0",
    "ejs": "6.0.1",
    "express": "5.2.1",
    "express-session": "1.19.0",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "vitest": "4.1.7"
  }
}
